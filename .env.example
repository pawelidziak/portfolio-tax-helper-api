# AWS CDK Configuration
# Copy this file to .env and fill in your values
# 
# To use: cp .env.example .env
# Then edit .env with your actual values

# AWS Account ID (optional - CDK will detect it automatically from your credentials)
# CDK_DEFAULT_ACCOUNT=123456789012

# AWS Region (default: eu-west-1)
# Options: eu-west-1, us-east-1, us-west-2, etc.
CDK_DEFAULT_REGION=eu-west-1

# AWS Profile name (optional - if not set, uses default profile)
# This should match the profile name you configured with: aws configure --profile portfolio-api
AWS_PROFILE=portfolio-api
