# AWS CDK Configuration
# Copy this file to .env and fill in your values
#
# To use: cp .env.example .env
# Then edit .env with your actual values

# AWS Account ID (optional - CDK will detect it automatically from your credentials)
# CDK_DEFAULT_ACCOUNT=123456789012

# AWS Region (default: eu-west-1)
# Options: eu-west-1, us-east-1, us-west-2, etc.
CDK_DEFAULT_REGION=eu-west-1

# AWS Profile name (optional - if not set, uses default profile)
# This should match the profile name you configured with: aws configure --profile portfolio-api
AWS_PROFILE=portfolio-api

# CORS: comma-separated origins allowed to call the API (e.g. https://my-app.vercel.app).
# Leave unset to allow every origin - use only for local development.
# ALLOWED_ORIGINS=https://my-app.vercel.app

# NBP API Configuration (National Bank of Poland Exchange Rates)
# Base URL for NBP API
NBP_API_BASE_URL=https://api.nbp.pl/api

# Table type (a = average rates, b = buy/sell rates, c = bid/ask rates)
NBP_API_TABLE_TYPE=a

# Response format (json or xml)
NBP_API_FORMAT=json

# PLN rate (default: 1.0, as PLN is the base currency)
NBP_API_PLN_RATE=1.0
