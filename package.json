{
  "name": "portfolio-api",
  "version": "1.0.0",
  "description": "Projekt AWS Lambda z API Gateway używający AWS CDK",
  "scripts": {
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "deploy": "sh -c 'env=${1:-dev} cdk deploy --context env=$env --profile portfolio-api' --",
    "synth": "sh -c 'env=${1:-dev} cdk synth --context env=$env --profile portfolio-api' --",
    "diff": "sh -c 'env=${1:-dev} cdk diff --context env=$env --profile portfolio-api' --",
    "destroy": "sh -c 'env=${1:-dev} cdk destroy --context env=$env --profile portfolio-api' --",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "check:aws": "aws sts get-caller-identity --profile portfolio-api",
    "parse:local:ibkr": "tsx scripts/parse-local-ibkr.ts"
  },
  "keywords": [
    "aws",
    "cdk",
    "lambda",
    "api-gateway",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "aws-cdk": "^2.120.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "typescript-json-schema": "^0.65.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.925.0",
    "@aws-sdk/lib-dynamodb": "^3.925.0",
    "aws-cdk-lib": "^2.120.0",
    "busboy": "^1.6.0",
    "constructs": "^10.3.0",
    "prettier-plugin-sort-imports": "^1.8.8",
    "zod": "^4.1.12"
  }
}
